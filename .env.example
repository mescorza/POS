# Ejemplo: postgresql://postgres:<password>@localhost:5432/POS
DATABASE_URL=""

# Conexión a Postgres usada por PostgresConnection cuando DATABASE_URL está vacío.
# La base del proyecto se llama "POS" (no "postgres"), ver _v_datos/modelo_usuarios.sql
PGHOST=localhost
PGPORT=5432
PGDATABASE=POS
PGUSER=postgres
PGPASSWORD=
